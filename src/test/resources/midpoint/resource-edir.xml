<!--
  midPoint resource for TestMidPointIntegration. The ${...} placeholders are substituted
  by the test from the test.edir.* system properties.

  Note the cfg namespace: midPoint derives it from the connector bundle name and the
  connector class, as
      .../icf-1/bundle/{ConnectorBundle-Name}/{connectorType}
  Renaming the Maven artifactId changes ConnectorBundle-Name and therefore this
  namespace, which is what makes such a rename a migration for every existing resource.
  TestMidPointIntegration asserts that the deployed connector still matches it.
-->
<resource xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
          xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
          xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
          xmlns:icfc="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3"
          oid="${oid}">

    <name>eDirectory (connector test rig)</name>
    <description>Created by TestMidPointIntegration. Safe to delete.</description>

    <connectorRef type="c:ConnectorType">
        <filter>
            <q:equal>
                <q:path>c:connectorType</q:path>
                <q:value>com.evolveum.polygon.connector.ldap.edirectory.EDirectoryLdapConnector</q:value>
            </q:equal>
        </filter>
    </connectorRef>

    <connectorConfiguration>
        <icfc:configurationProperties
                xmlns:cfg="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/${bundle}/com.evolveum.polygon.connector.ldap.edirectory.EDirectoryLdapConnector">
            <cfg:host>${host}</cfg:host>
            <cfg:port>${port}</cfg:port>
            <cfg:connectionSecurity>${connectionSecurity}</cfg:connectionSecurity>
            <cfg:authenticationType>simple</cfg:authenticationType>
            <cfg:bindDn>${bindDn}</cfg:bindDn>
            <cfg:bindPassword>
                <clearValue>${bindPassword}</clearValue>
            </cfg:bindPassword>
            <cfg:baseContext>${baseContext}</cfg:baseContext>
            <cfg:allowUntrustedSsl>true</cfg:allowUntrustedSsl>
            <cfg:pagingStrategy>spr</cfg:pagingStrategy>
            <cfg:synchronizationStrategy>modifyTimestamp</cfg:synchronizationStrategy>
        </icfc:configurationProperties>
    </connectorConfiguration>

</resource>
