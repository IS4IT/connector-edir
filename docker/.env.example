# Copy to docker/.env and adjust. docker/.env is gitignored: it holds passwords and
# points at a licensed image in a private registry.

# --- eDirectory ---------------------------------------------------------------

# Licensed image from the private registry: `docker login hub.is4it.de` first.
# linux/amd64 only — runs under emulation on Apple Silicon.
EDIR_IMAGE=hub.is4it.de/vendor/netiq/idm/identityengine:idm-4.10.2-591

# Tree admin password, also used as COMMON_PASSWORD.
# Keep it alphanumeric: the image's /startidm.sh dumps the container environment with
# `env > file` and then `source`s it, so a value containing spaces or shell
# metacharacters breaks the silent install in a confusing way.
EDIR_PASSWORD=n0v3ll

EDIR_TREENAME=CONNTEST
EDIR_ADMIN_DN=cn=admin,ou=sa,o=system

# --- addressing ---------------------------------------------------------------

# Every service gets a static address, as idm-compose does. eDirectory must be pinned:
# ndsconfig binds NDAP to whatever ID_VAULT_HOST resolves to and refuses to configure if
# that is not an address on one of its own interfaces. Leaving the others dynamic is not
# an option either — Docker would hand .2 to whichever container it creates first, and
# eDirectory then fails to start with "Address already in use".
EDIR_SUBNET=172.28.20.0/24
EDIR_IP=172.28.20.2
MP_SERVER_IP=172.28.20.20
MP_DATA_IP=172.28.20.21
MP_INIT_IP=172.28.20.22
SEED_IP=172.28.20.40

# Ports. Defaults are in the 20xxx range so this rig can run alongside idm-compose,
# which occupies 7389/7636/7828/7830. Published 1:1 — the container listens on these
# same numbers, so logs and test configuration agree.
EDIR_LDAP_PORT=20389
EDIR_LDAPS_PORT=20636
EDIR_HTTP_PORT=20828
EDIR_HTTPS_PORT=20830
# Set but not published — nothing outside the container needs NCP.
EDIR_NCP_PORT=20524

# --- midPoint -----------------------------------------------------------------

MP_VER=4.10.3
PG_VER=17

# Host port for the GUI and REST API (the container always listens on 8080).
MP_PORT=20080

MP_ADMIN_PASSWORD=T3stPw890uio
MP_DB_PASSWORD=db.secret.pw.007

# --- misc ---------------------------------------------------------------------

TZ=Europe/Berlin
